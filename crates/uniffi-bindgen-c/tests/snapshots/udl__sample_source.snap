void sample_uniffi_write_Holder(uniffi_writer *w, sample_Holder value) {
    (void)w;
    (void)value;
    sample_uniffi_write_Thing(w, value.thing);
}

sample_Holder sample_uniffi_read_Holder(uniffi_reader *r) {
    sample_Holder value;
    memset(&value, 0, sizeof value);
    (void)r;
    value.thing = sample_uniffi_read_Thing(r);
    return value;
}

void sample_Holder_free(sample_Holder *value) {
    if (!value) {
        return;
    }
    sample_Thing_free(value->thing);
    memset(value, 0, sizeof *value);
}

void sample_uniffi_write_Point(uniffi_writer *w, sample_Point value) {
    (void)w;
    (void)value;
    uniffi_write_f64(w, value.x);
    uniffi_write_f64(w, value.y);
    sample_uniffi_write_OptionString(w, value.label);
}

sample_Point sample_uniffi_read_Point(uniffi_reader *r) {
    sample_Point value;
    memset(&value, 0, sizeof value);
    (void)r;
    value.x = uniffi_read_f64(r);
