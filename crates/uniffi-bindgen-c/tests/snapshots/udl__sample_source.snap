                message = uniffi_string_copy("an error the bindings do not expect", 35);
            }
            uniffi_fail(status, UNIFFI_ERROR, message);
            return false;
        }
        case UNIFFI_CALL_UNEXPECTED_ERROR: {
            uniffi_string message = call->error_buf.len
                ? uniffi_string_copy((const char *)call->error_buf.data, (size_t)call->error_buf.len)
                : uniffi_string_copy("Rust panicked", 13);
            uniffi_buffer_free(call->error_buf);
            uniffi_fail(status, UNIFFI_PANIC, message);
            return false;
        }
        case UNIFFI_CALL_CANCELLED:
            uniffi_fail_str(status, UNIFFI_CANCELLED, "the call was cancelled");
            return false;
        default:
            uniffi_fail_str(status, UNIFFI_INTERNAL, "unexpected RustCallStatus code");
            return false;
    }
