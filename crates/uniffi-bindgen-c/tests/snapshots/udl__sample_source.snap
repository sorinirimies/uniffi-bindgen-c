static UNIFFI_MAYBE_UNUSED void sample_uniffi_write_OptionString(uniffi_writer *w, sample_OptionString value) {
    uniffi_write_i8(w, value.has_value ? 1 : 0);
    if (value.has_value) {
        uniffi_write_string(w, value.value);
    }
}

static UNIFFI_MAYBE_UNUSED sample_OptionString sample_uniffi_read_OptionString(uniffi_reader *r) {
    sample_OptionString value;
    memset(&value, 0, sizeof value);
    switch (uniffi_read_i8(r)) {
        case 0:
            break;
        case 1:
            value.has_value = true;
            value.value = uniffi_read_string(r);
            break;
        default:
            r->failed = true;
    }
    return value;
}

void sample_OptionString_free(sample_OptionString *value) {
    if (!value) {
        return;
    }
    if (value->has_value) {
        uniffi_string_free(&value->value);
    }
    memset(value, 0, sizeof *value);
}

static UNIFFI_MAYBE_UNUSED void sample_uniffi_write_SequenceString(uniffi_writer *w, sample_SequenceString value) {
    uniffi_write_len(w, value.len);
    for (size_t i = 0; i < value.len; ++i) {
        uniffi_write_string(w, value.items[i]);
    }
}

static UNIFFI_MAYBE_UNUSED sample_SequenceString sample_uniffi_read_SequenceString(uniffi_reader *r) {
    sample_SequenceString value;
    memset(&value, 0, sizeof value);
    size_t len = uniffi_read_len(r, 4);
    if (r->failed) {
        return value;
    }
    value.items = (uniffi_string *)uniffi_alloc(len * sizeof *value.items);
    for (size_t i = 0; i < len && !r->failed; ++i) {
        value.items[i] = uniffi_read_string(r);
        value.len = i + 1;
    }
    return value;
}

void sample_SequenceString_free(sample_SequenceString *value) {
    if (!value) {
        return;
    }
    for (size_t i = 0; i < value->len; ++i) {
        uniffi_string_free(&value->items[i]);
    }
    free(value->items);
    memset(value, 0, sizeof *value);
}

static UNIFFI_MAYBE_UNUSED void sample_uniffi_write_MapStringU32(uniffi_writer *w, sample_MapStringU32 value) {
    uniffi_write_len(w, value.len);
    for (size_t i = 0; i < value.len; ++i) {
        uniffi_write_string(w, value.keys[i]);
        uniffi_write_u32(w, value.values[i]);
    }
}

static UNIFFI_MAYBE_UNUSED sample_MapStringU32 sample_uniffi_read_MapStringU32(uniffi_reader *r) {
    sample_MapStringU32 value;
    memset(&value, 0, sizeof value);
    size_t len = uniffi_read_len(r, 8);
    if (r->failed) {
        return value;
    }
    value.keys = (uniffi_string *)uniffi_alloc(len * sizeof *value.keys);
    value.values = (uint32_t *)uniffi_alloc(len * sizeof *value.values);
    for (size_t i = 0; i < len && !r->failed; ++i) {
        value.keys[i] = uniffi_read_string(r);
        value.values[i] = uniffi_read_u32(r);
        value.len = i + 1;
    }
    return value;
}

void sample_MapStringU32_free(sample_MapStringU32 *value) {
    if (!value) {
        return;
    }
    for (size_t i = 0; i < value->len; ++i) {
        uniffi_string_free(&value->keys[i]);
    }
    free(value->keys);
    free(value->values);
    memset(value, 0, sizeof *value);
}

static UNIFFI_MAYBE_UNUSED RustBuffer sample_uniffi_lower_String(uniffi_string value) {
    return uniffi_buffer_from(value.data, value.len);
}

static UNIFFI_MAYBE_UNUSED uniffi_string sample_uniffi_lift_String(RustBuffer buffer) {
    uniffi_string value = uniffi_string_copy((const char *)buffer.data, (size_t)buffer.len);
    uniffi_buffer_free(buffer);
    return value;
}

static UNIFFI_MAYBE_UNUSED RustBuffer sample_uniffi_lower_Bytes(uniffi_bytes value) {
    uniffi_writer w = {NULL, 0, 0};
    uniffi_write_bytes(&w, value);
    RustBuffer buffer = uniffi_buffer_from(w.data, w.len);
    uniffi_writer_free(&w);
    return buffer;
}

static UNIFFI_MAYBE_UNUSED uniffi_bytes sample_uniffi_lift_Bytes(RustBuffer buffer) {
    uniffi_reader r = uniffi_reader_new(buffer.data, (size_t)buffer.len);
    uniffi_bytes value = uniffi_read_bytes(&r);
    bool bad = r.failed || uniffi_reader_remaining(&r) != 0;
    uniffi_buffer_free(buffer);
    if (bad) {
        fputs("uniffi: Rust sent a malformed Bytes\n", stderr);
        abort();
    }
    return value;
}

