static UNIFFI_MAYBE_UNUSED void sample_uniffi_lift_error_Oops(RustBuffer buffer, void *out, uniffi_string *message) {
    sample_Oops value = sample_uniffi_lift_Oops(buffer);
    const char *variant = sample_Oops_uniffi_variant_name(value);
    size_t n = strlen(variant);
    size_t total = n + 2 + value.message.len;
    uniffi_string text;
    text.data = (char *)uniffi_alloc(total + 1);
    memcpy(text.data, variant, n);
    text.data[n] = ':';
    text.data[n + 1] = ' ';
    if (value.message.len) {
        memcpy(text.data + n + 2, value.message.data, value.message.len);
    }
    text.data[total] = '\0';
    text.len = total;
    *message = text;
    if (out) {
        *(sample_Oops *)out = value;
    } else {
        sample_Oops_free(&value);
    }
}

uint64_t sample_Sink_uniffi_lower(sample_Sink value) {
    return sample_Sink_uniffi_insert(value.vtable, value.ctx);
}

sample_Sink sample_Sink_uniffi_lift(uint64_t handle) {
    sample_Sink value = {NULL, NULL};
    sample_Sink_uniffi_record *rec = (sample_Sink_uniffi_record *)uniffi_handle_map_get(&sample_Sink_uniffi_handles, handle);
    if (rec) {
        value.vtable = rec->vtable;
        value.ctx = rec->ctx;
    }
    sample_Sink_uniffi_drop(handle);
    return value;
}

void sample_Thing_free(sample_Thing self) {
    if (self.handle == 0) {
        return;
    }
    RustCallStatus uniffi_call = {0};
    uniffi_sample_fn_free_thing(self.handle, &uniffi_call);
}

sample_Thing sample_Thing_clone(sample_Thing self) {
    sample_Thing out = {0};
    if (self.handle == 0) {
        return out;
    }
    sample_uniffi_ensure_init();
    RustCallStatus uniffi_call = {0};
    out.handle = uniffi_sample_fn_clone_thing(self.handle, &uniffi_call);
    uniffi_check_call(&uniffi_call, NULL, NULL, NULL);
    return out;
}

uint64_t sample_Thing_uniffi_lower(sample_Thing value) {
    return sample_Thing_clone(value).handle;
}

sample_Thing sample_Thing_uniffi_lift(uint64_t handle) {
    sample_Thing value;
    value.handle = handle;
    return value;
}

sample_Thing sample_Thing_new(uniffi_string name, uniffi_status *status) {
    sample_uniffi_ensure_init();
    RustCallStatus uniffi_call = {0};
    uint64_t uniffi_result = uniffi_sample_fn_constructor_thing_new(sample_uniffi_lower_String(name), &uniffi_call);
    if (!uniffi_check_call(&uniffi_call, status, NULL, NULL)) {
        sample_Thing uniffi_zero;
        memset(&uniffi_zero, 0, sizeof uniffi_zero);
        return uniffi_zero;
    }
    return sample_Thing_uniffi_lift(uniffi_result);
}

sample_Thing sample_Thing_other(uint32_t n, uniffi_status *status) {
    sample_uniffi_ensure_init();
    RustCallStatus uniffi_call = {0};
    uint64_t uniffi_result = uniffi_sample_fn_constructor_thing_other(n, &uniffi_call);
    if (!uniffi_check_call(&uniffi_call, status, NULL, NULL)) {
        sample_Thing uniffi_zero;
        memset(&uniffi_zero, 0, sizeof uniffi_zero);
        return uniffi_zero;
    }
    return sample_Thing_uniffi_lift(uniffi_result);
}

void sample_Thing_check(sample_Thing self, sample_Oops *err, uniffi_status *status) {
    sample_uniffi_ensure_init();
    RustCallStatus uniffi_call = {0};
    uniffi_sample_fn_method_thing_check(sample_Thing_uniffi_lower(self), &uniffi_call);
    uniffi_check_call(&uniffi_call, status, sample_uniffi_lift_error_Oops, err);
}

uint32_t sample_Thing_later(sample_Thing self, uniffi_status *status) {
    sample_uniffi_ensure_init();
    uint64_t uniffi_future = uniffi_sample_fn_method_thing_later(sample_Thing_uniffi_lower(self));
