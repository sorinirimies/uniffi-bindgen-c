    sample_OptionString_free(&value->label);
    memset(value, 0, sizeof *value);
}

void sample_uniffi_write_Color(uniffi_writer *w, sample_Color value) {
    switch (value) {
        case sample_Color_Red: uniffi_write_i32(w, 1); return;
        case sample_Color_Green: uniffi_write_i32(w, 2); return;
    }
    uniffi_write_i32(w, 0);
}

sample_Color sample_uniffi_read_Color(uniffi_reader *r) {
    switch (uniffi_read_i32(r)) {
        case 1: return sample_Color_Red;
        case 2: return sample_Color_Green;
        default: r->failed = true; return sample_Color_Red;
    }
}

void sample_Color_free(sample_Color *value) {
    (void)value;
}

void sample_uniffi_write_Detailed(uniffi_writer *w, sample_Detailed value) {
    switch (value.tag) {
        case sample_Detailed_Code:
            uniffi_write_i32(w, 1);
            uniffi_write_i32(w, value.u.Code.code);
            return;
        case sample_Detailed_Empty:
            uniffi_write_i32(w, 2);
            return;
        default:
            break;
    }
    uniffi_write_i32(w, 0);
}

sample_Detailed sample_uniffi_read_Detailed(uniffi_reader *r) {
    sample_Detailed value;
    memset(&value, 0, sizeof value);
    switch (uniffi_read_i32(r)) {
        case 1:
            value.tag = sample_Detailed_Code;
            value.u.Code.code = uniffi_read_i32(r);
            return value;
        case 2:
            value.tag = sample_Detailed_Empty;
            return value;
        default:
            r->failed = true;
            return value;
    }
}

void sample_Detailed_free(sample_Detailed *value) {
    if (!value) {
        return;
    }
    switch (value->tag) {
        case sample_Detailed_Code:
            break;
        case sample_Detailed_Empty:
            break;
        default:
            break;
    }
    memset(value, 0, sizeof *value);
}

/* The variant name of an error, for its message. */
static UNIFFI_MAYBE_UNUSED const char *sample_Detailed_uniffi_variant_name(sample_Detailed value) {
    static const char *const names[] = {"Code", "Empty", NULL};
    return ((size_t)value.tag < sizeof names / sizeof names[0] - 1) ? names[value.tag] : "Detailed";
}

void sample_uniffi_write_Oops(uniffi_writer *w, sample_Oops value) {
    switch (value.tag) {
        case sample_Oops_Bad:
            uniffi_write_i32(w, 1);
            return;
        case sample_Oops_Worse:
            uniffi_write_i32(w, 2);
            return;
        default:
            break;
    }
    uniffi_write_i32(w, 0);
}

sample_Oops sample_uniffi_read_Oops(uniffi_reader *r) {
    sample_Oops value;
    memset(&value, 0, sizeof value);
    switch (uniffi_read_i32(r)) {
        case 1:
            value.tag = sample_Oops_Bad;
            value.message = uniffi_read_string(r);
            return value;
        case 2:
            value.tag = sample_Oops_Worse;
            value.message = uniffi_read_string(r);
            return value;
        default:
            r->failed = true;
            return value;
    }
}

void sample_Oops_free(sample_Oops *value) {
