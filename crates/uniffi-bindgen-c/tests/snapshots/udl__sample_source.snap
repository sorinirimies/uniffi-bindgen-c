/* Turns a call status into `status` (and `*err`); true when the call succeeded. */
static UNIFFI_MAYBE_UNUSED bool uniffi_check_call(RustCallStatus *call, uniffi_status *status, uniffi_error_lifter lift_error, void *err) {
